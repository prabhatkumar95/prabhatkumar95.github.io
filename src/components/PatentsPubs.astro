---
import { Award, BookOpen, ExternalLink, ShieldCheck } from '@lucide/astro';
import type { Patent, Publication } from '../data/loader';

interface Props {
  patents: Patent[];
  publications: Publication[];
  scholarUrl: string;
}

const { patents, publications, scholarUrl } = Astro.props;
---

<section id="research" class="py-16 sm:py-20 border-b border-zinc-200/60 dark:border-zinc-800/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <div class="space-y-2 mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
        <Award class="w-4 h-4" />
        <span>Intellectual Property & Scholarly Work</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Patents & Publications
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 max-w-2xl text-sm sm:text-base">
        Published patents in sensor perception and peer-reviewed research papers in top computer vision venues.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Patents Column -->
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
          <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <ShieldCheck class="w-5 h-5 text-amber-500" />
            <span>Published Patents (3)</span>
          </h3>
          <span class="text-xs font-medium text-zinc-500">Bosch Research</span>
        </div>

        <div class="space-y-3">
          {patents.map((patent) => (
            <div class="rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-900/50 p-4 backdrop-blur-xs hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                    <span class={`px-2 py-0.5 rounded text-[11px] font-semibold tracking-wide ${
                      patent.jurisdiction.includes('US')
                        ? 'bg-blue-500/10 text-blue-700 dark:bg-blue-500/15 dark:text-blue-300 border border-blue-500/20'
                        : 'bg-emerald-500/10 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300 border border-emerald-500/20'
                    }`}>
                      {patent.jurisdiction}
                    </span>
                    <span class="text-xs text-zinc-500 font-medium">Published {patent.year}</span>
                    {patent.patent_number && (
                      <span class="text-xs text-zinc-400 dark:text-zinc-500 font-mono">({patent.patent_number})</span>
                    )}
                  </div>
                  <h4 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 leading-snug">
                    {patent.title}
                  </h4>
                </div>
                {patent.url && (
                  <a
                    href={patent.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1 text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 shrink-0"
                    aria-label="View patent document"
                  >
                    <ExternalLink class="w-4 h-4" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Publications Column -->
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
          <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <BookOpen class="w-5 h-5 text-indigo-500" />
            <span>Conference Papers</span>
          </h3>
          <a
            href={scholarUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1"
          >
            <span>Google Scholar</span>
            <ExternalLink class="w-3 h-3" />
          </a>
        </div>

        <div class="space-y-3">
          {publications.map((pub) => (
            <div class="rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-900/50 p-4 backdrop-blur-xs hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
              <div class="flex items-start justify-between gap-3">
                <div class="space-y-1">
                  <span class="inline-block px-2 py-0.5 rounded text-[11px] font-semibold bg-indigo-500/10 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300 border border-indigo-500/20">
                    {pub.venue} • {pub.year}
                  </span>
                  <h4 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 leading-snug pt-1">
                    {pub.title}
                  </h4>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">
                    {pub.authors}
                  </p>
                </div>
                {pub.url && (
                  <a
                    href={pub.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1 text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 shrink-0"
                    aria-label={`Read paper: ${pub.title}`}
                  >
                    <ExternalLink class="w-4 h-4" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
