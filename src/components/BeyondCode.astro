---
import { Globe, Languages, Compass } from '@lucide/astro';
import type { BeyondTheCode } from '../data/loader';

interface Props {
  beyond: BeyondTheCode;
}

const { beyond } = Astro.props;
---

<section id="about" class="py-16 sm:py-20 border-b border-zinc-200/60 dark:border-zinc-800/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <div class="space-y-2 mb-10">
      <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
        <Globe class="w-4 h-4" />
        <span>Perspectives & Culture</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Beyond the Code
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Collaboration & Mindset -->
      <div class="md:col-span-2 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-900/50 p-6 backdrop-blur-xs flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center gap-2 text-zinc-900 dark:text-zinc-100 font-bold text-base">
            <Compass class="w-4 h-4 text-indigo-500" />
            <h3>Global Collaboration & Engineering Mindset</h3>
          </div>
          <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed font-normal">
            {beyond.text}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 text-xs text-zinc-500 dark:text-zinc-400 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>{beyond.travel_familiarity}</span>
        </div>
      </div>

      <!-- Languages & Adaptability -->
      <div class="rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-900/50 p-6 backdrop-blur-xs flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center gap-2 text-zinc-900 dark:text-zinc-100 font-bold text-base">
            <Languages class="w-4 h-4 text-emerald-500" />
            <h3>Languages</h3>
          </div>
          <div class="space-y-3">
            {beyond.languages.map((lang) => (
              <div class="space-y-0.5">
                <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 block">
                  {lang.name}
                </span>
                <span class="text-xs text-zinc-500 dark:text-zinc-400">
                  {lang.level}
                </span>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800/80">
          <span class="text-xs text-zinc-400 dark:text-zinc-500 italic block">
            Open to full-time international relocation
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
