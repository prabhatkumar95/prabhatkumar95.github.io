---
import { GraduationCap, Calendar } from '@lucide/astro';
import type { Education } from '../data/loader';

interface Props {
  education: Education[];
}

const { education } = Astro.props;
---

<section id="education" class="py-16 sm:py-20 border-b border-zinc-200/60 dark:border-zinc-800/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <div class="space-y-2 mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
        <GraduationCap class="w-4 h-4" />
        <span>Academic Foundations</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Education
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 max-w-2xl text-sm sm:text-base">
        Degrees and graduate research in computer vision, deep learning, and data engineering.
      </p>
    </div>

    <!-- Education Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {education.map((item) => (
        <div class="rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-900/50 p-6 flex flex-col justify-between backdrop-blur-xs hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400 font-medium">
              <span class="inline-flex items-center gap-1">
                <Calendar class="w-3.5 h-3.5" />
                <span>{item.period}</span>
              </span>
            </div>

            <div>
              <h3 class="font-bold text-base sm:text-lg text-zinc-900 dark:text-zinc-100 leading-snug">
                {item.degree}
              </h3>
              <p class="text-xs sm:text-sm text-indigo-600 dark:text-indigo-400 font-medium mt-1">
                {item.institution}
              </p>
            </div>
          </div>

          {item.note && (
            <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80">
              <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed flex items-start gap-1.5">
                <span class="text-emerald-500 dark:text-emerald-400 shrink-0 font-bold">✓</span>
                <span>{item.note}</span>
              </p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
