---
import { Briefcase, Calendar, MapPin } from '@lucide/astro';
import type { Experience } from '../data/loader';

interface Props {
  experience: Experience[];
}

const { experience } = Astro.props;
---

<section id="experience" class="py-16 sm:py-20 border-b border-zinc-200/60 dark:border-zinc-800/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <div class="space-y-2 mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
        <Briefcase class="w-4 h-4" />
        <span>Career Trajectory</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Work Experience
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 max-w-2xl text-sm sm:text-base">
        Over 7 years translating fundamental ML research into production algorithms across industry-leading teams.
      </p>
    </div>

    <!-- Timeline List -->
    <div class="relative pl-6 sm:pl-8 border-l border-zinc-200 dark:border-zinc-800 space-y-10">
      {experience.map((item) => (
        <div class="relative group">
          <!-- Timeline Node Point -->
          <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3.5 h-3.5 rounded-full border-2 border-indigo-600 bg-white dark:bg-zinc-950 dark:border-indigo-400"></div>

          <!-- Content Card -->
          <div class="rounded-xl border border-zinc-200/70 dark:border-zinc-800/70 bg-white/50 dark:bg-zinc-900/40 p-5 sm:p-6 backdrop-blur-xs">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
              <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">
                {item.role} <span class="text-indigo-600 dark:text-indigo-400 font-medium">@ {item.company}</span>
              </h3>
              <div class="flex items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400">
                <span class="inline-flex items-center gap-1">
                  <Calendar class="w-3.5 h-3.5" />
                  <span>{item.period}</span>
                </span>
                <span>•</span>
                <span class="inline-flex items-center gap-1">
                  <MapPin class="w-3.5 h-3.5" />
                  <span>{item.location}</span>
                </span>
              </div>
            </div>

            {item.summary && (
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 italic mb-3">
                {item.summary}
              </p>
            )}

            <!-- Bullet Points -->
            <ul class="space-y-2 mt-3">
              {item.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-400 dark:bg-zinc-600 mt-2 shrink-0"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
